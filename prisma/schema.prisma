generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["auth", "public"]
}

model certificates {
  id                Int       @id @default(autoincrement())
  name              String?
  syllabus_id       Int?
  certificate_image String?
  created_by        Int?
  created_at        DateTime? @db.Timestamp(6)
  updated_at        DateTime? @updatedAt @db.Timestamp(6)
  email             String?
  syllabus_name     String?
  syllabus_pdf      String?
  issue_date        DateTime? @db.Date
  certificate_code  String?
  status            String?
  syllabi           syllabi?  @relation(fields: [syllabus_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_certificates_syllabus")

  @@schema("public")
}

model online_tutors {
  id            Int       @id @default(autoincrement())
  name          String?
  designation   String?
  signature_url String?
  syllabi       syllabi[]

  @@schema("public")
}

model syllabi {
  id            Int            @id @default(autoincrement())
  name          String?
  syllabus_pdf  String?
  description   String?
  created_by    Int?
  created_at    DateTime?      @db.Timestamp(6)
  updated_at    DateTime?      @updatedAt @db.Timestamp(6)
  duration      String?
  status        String?        @default("active")
  tutor_id      Int?
  course_code String?
  certificates  certificates[]
  online_tutors online_tutors? @relation(fields: [tutor_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_syllabi_tutor")

  @@schema("public")
}

